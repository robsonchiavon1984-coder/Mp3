{
  "name": "Leitor em Voz — PDF e Textos",
  "short_name": "Leitor em Voz",
  "description": "Le em voz alta, em portugues, PDFs e textos. Funciona sem internet depois de instalado.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f6f7f9",
  "theme_color": "#1e3a5f",
  "categories": ["productivity", "utilities", "education"],
  "icons": [
    { "src": "icone-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icone-mascara-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "url": "url",
      "files": [
        {
          "name": "arquivo",
          "accept": ["application/pdf", "text/plain", "text/markdown", ".pdf", ".txt", ".md"]
        }
      ]
    }
  }
}
